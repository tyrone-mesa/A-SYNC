# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/asiatech-sync

# Generate a random JWT secret with at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin used by CORS and password-reset links.
CLIENT_URL=http://localhost:3000

# Initial admin seed values. Existing admin passwords are not overwritten on startup.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# Upload scanning and storage
CLAMAV_SCAN=false
CLAMSCAN_PATH=clamscan
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email service (Resend API is recommended)
RESEND_API_KEY=
RESEND_FROM=ASIATECH SYNC <onboarding@resend.dev>

# SMTP fallback (or use smtp.resend.com)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Strong secret/passphrase for restricted admin views.
ADMIN_SENSITIVE_PIN=

# Optional AI interview integration.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
